rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Liste des emails autorisés à gérer le site (comptes créés dans Firebase Authentication).
    // Mets l'email de ton amie en premier, et le tien si tu veux garder l'accès.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['email-de-ton-amie@exemple.com', 'ton-email@exemple.com'];
    }

    // Les voitures sont visibles par tout le monde, modifiables par l'admin seulement
    match /vehicles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Les visiteurs peuvent envoyer une demande, seul l'admin peut les lire et les gérer
    match /reservations/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['nom', 'tel', 'car', 'city', 'start', 'end', 'days', 'total', 'status', 'createdAt'])
                    && request.resource.data.status == 'nouvelle'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.nom is string && request.resource.data.nom.size() <= 100
                    && request.resource.data.tel is string && request.resource.data.tel.size() <= 40
                    && request.resource.data.car is string && request.resource.data.car.size() <= 100
                    && request.resource.data.days is number && request.resource.data.total is number;
      allow read, update, delete: if isAdmin();
    }
  }
}
